# Selecione explicitamente o perfil: development, test, staging ou production.
FALL_ENVIRONMENT=development
# Defina somente a URL do perfil selecionado. Estes exemplos usam apenas o
# PostgreSQL local de compose.yaml; nunca reutilize as credenciais em servidores.
FALL_DEVELOPMENT_DATABASE_URL=postgresql+psycopg://fall_local:fall_local_only@127.0.0.1:55432/fall_development
# FALL_TEST_DATABASE_URL=postgresql+psycopg://fall_local:fall_local_only@127.0.0.1:55433/fall_test
# FALL_STAGING_DATABASE_URL=postgresql+psycopg://usuario:senha@host/banco_homologacao
# FALL_PRODUCTION_DATABASE_URL=postgresql+psycopg://usuario:senha@host/banco_producao
